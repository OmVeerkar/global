# Global Interio — Environment Variables Example
# Duplicate this file to .env.local for local overrides if needed.

# Centralized business WhatsApp number (format: country code + digits, e.g. 919876543210 for India)
VITE_WHATSAPP_NUMBER=919876543210

# Optional Google Analytics / Tag Manager
VITE_GA_TRACKING_ID=

# Studio Contact Email
VITE_CONTACT_EMAIL=info@globalinterio.com
